{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CertificateExtractionResult",
  "type": "object",
  "properties": {
    "certificate": {
      "type": "object",
      "properties": {
        "issueNumber": { "type": ["string", "null"] },
        "issueDate": { "type": ["string", "null"] },
        "registryNumber": { "type": ["string", "null"] }
      },
      "required": ["issueNumber", "issueDate", "registryNumber"]
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fullName": { "type": "string" },
          "identityNumber": { "type": ["string", "null"] },
          "dateOfBirth": { "type": ["string", "null"] },
          "residenceAddress": { "type": ["string", "null"] }
        },
        "required": ["fullName"]
      }
    },
    "parcels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mapSheetNumber": { "type": ["string", "null"] },
          "parcelNumber": { "type": ["string", "null"] },
          "area": { "type": ["string", "null"] },
          "oldWard": { "type": ["string", "null"] }
        },
        "required": ["mapSheetNumber", "parcelNumber", "area"]
      }
    },
    "unreadableFields": {
      "type": "array",
      "description": "Đường dẫn (fieldPath) của mọi trường không đọc rõ được — value tương ứng phải là null. Không được để trống mảng này rồi vẫn đoán chữ số/tự sửa mã đất/tự cộng diện tích (GEMINI.md §6.4).",
      "items": { "type": "string" },
      "default": []
    }
  },
  "required": ["certificate", "owners", "parcels", "unreadableFields"]
}
