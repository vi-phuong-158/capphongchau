{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CertificateExtractionResultV2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documentType": { "enum": ["CERTIFICATE", "OTHER", "UNKNOWN"] },
        "imageStatus": { "enum": ["CLEAR", "BLURRY", "HANDWRITING", "MIXED"] },
        "note": { "type": "string" }
      },
      "required": ["documentType", "imageStatus", "note"]
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issueNumber": { "$ref": "#/definitions/field" },
        "issueDate": { "$ref": "#/definitions/field" },
        "registryNumber": { "$ref": "#/definitions/field" }
      },
      "required": ["issueNumber", "issueDate", "registryNumber"]
    },
    "unreadableFields": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["quality", "certificate", "unreadableFields"],
  "definitions": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["string", "null"] },
        "sourceValue": { "type": ["string", "null"] },
        "status": { "enum": ["CLEAR", "CHECK", "MANUAL_REQUIRED"] },
        "evidence": {
          "type": ["object", "null"],
          "properties": {
            "fileId": { "type": "string" },
            "pageLabel": { "type": "string" },
            "note": { "type": "string" }
          },
          "required": ["fileId", "pageLabel", "note"]
        }
      },
      "required": ["value", "sourceValue", "status", "evidence"]
    }
  }
}
