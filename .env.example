# URL công khai của ứng dụng, không có dấu gạch chéo ở cuối.
APP_BASE_URL=http://localhost:3000

# Tạo chuỗi ngẫu nhiên ít nhất 32 ký tự; không dùng giá trị mẫu này ở môi trường thật.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_GOOGLE_CLIENT_ID=replace-with-google-sign-in-client-id
AUTH_GOOGLE_CLIENT_SECRET=replace-with-google-sign-in-client-secret

# OAuth offline cho My Drive. Không dùng service account trong bản thử nghiệm.
GOOGLE_DRIVE_CLIENT_ID=replace-with-drive-oauth-client-id
GOOGLE_DRIVE_CLIENT_SECRET=replace-with-drive-oauth-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=replace-with-drive-oauth-refresh-token
GOOGLE_MY_DRIVE_ROOT_FOLDER_ID=replace-with-bootstrap-created-root-folder-id
GOOGLE_SHEETS_SPREADSHEET_ID=replace-with-bootstrap-created-spreadsheet-id

SYSTEM_ADMIN_EMAIL=anmphongandn@gmail.com
DATA_HASH_PEPPER=replace-with-a-separate-random-secret
MAX_UPLOAD_MB=30
VERCEL_REGION=sin1

# Cổng kê khai công khai. Người dân không có email nên phiên không dùng chung AUTH_SECRET.
PUBLIC_SESSION_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters
# Pepper của mã bí mật, tách khỏi DATA_HASH_PEPPER. Xoay giá trị này sẽ vô hiệu TOÀN BỘ
# mã bí mật đang lưu hành — chỉ làm khi có quy trình cấp lại.
PUBLIC_ACCESS_CODE_PEPPER=replace-with-a-separate-random-secret-of-at-least-32-characters

# Lớp biên Cloudflare (PLAN_NL §10.2).
# Cloudflare gắn header `X-Origin-Auth` mang đúng giá trị này vào mọi request chuyển tiếp;
# origin từ chối request công khai không có nó, để không ai gọi thẳng URL *.vercel.app mà
# bỏ qua WAF/rate limiting/Turnstile. Đặt bằng Transform Rule, không phải Page Rule.
ORIGIN_SHARED_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters

# Turnstile. Ở máy local dùng nguyên cặp khóa thử nghiệm chính thức của Cloudflare dưới đây —
# chúng luôn pass, nhờ vậy code không cần bất kỳ nhánh bypass nào cho môi trường dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# CHỈ dùng tạm khi test thủ công trên *.vercel.app trước khi có domain thật đứng sau Cloudflare —
# chưa gắn domain thì Cloudflare không cách nào gắn header được, dù origin có đòi đúng cách mấy.
# Mặc định KHÔNG đặt biến này. Xóa ngay khi đã có domain thật; còn bật là mở /ke-khai và
# /api/public/* cho bất kỳ ai gọi thẳng, đúng thứ hàng rào ORIGIN_SHARED_SECRET sinh ra để chặn.
# PUBLIC_INTAKE_SKIP_EDGE_GUARD_UNSAFE=true

CONSENT_NOTICE_VERSION=v1
PUBLIC_INTAKE_MODE=LIVE
MIN_DRIVE_FREE_GB=650
